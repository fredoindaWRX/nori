{
  "name": "nori",
  "private": true,
  "version": "0.0.0",
  "productName": "N.O.R.I.",
  "main": "desktop/main.cjs",
  "description": "N.O.R.I. unified desktop voice interface with a holographic shell and native Nori control-plane brain.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:dev": "node scripts/start-development.mjs",
    "desktop": "npm run build && electron .",
    "package:windows": "npm run package:windows:suite --",
    "package:windows:dir": "node scripts/build-renderer.mjs && node scripts/package-native-desktop.mjs",
    "stage:suite": "node scripts/stage-native-payload.mjs",
    "package:windows:suite": "node scripts/build-native-installer.mjs",
    "package:windows:native-installer": "node scripts/build-native-installer.mjs",
    "desktop:install": "node scripts/install-desktop-app.mjs --force",
    "install-app": "node scripts/install-desktop-app.mjs",
    "start:workspace": "node scripts/start.mjs --writes",
    "build": "node scripts/build-renderer.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "test:acceptance": "node --test --test-concurrency=1 tests/*.test.mjs tests/*.test.cjs",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:claude": "node scripts/bridge-run.mjs --claude",
    "bridge:writes": "node scripts/bridge-run.mjs --writes",
    "setup:voice": "node scripts/setup-local-stt.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "cesium": "1.145.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "leaflet": "1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "playwright-core": "1.64.1"
  }
}
